v2/ThStAM_derivate_00000299/annotation/ThStAM_derivate_00000299%2FUkM_A_002_6b.tif"}], "metadata": [], "label": "urn:nbn:de:urmel-1a3de989-388c-4449-a0e8-b1bbe0ebd5314-00000299-59", "height": 2314, "width": 1986, "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "sc:Canvas", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/ThStAM_derivate_00000299/canvas/ThStAM_derivate_00000299%2FUkM_A_002_6b.tif"}], "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "sc:Sequence", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/ThStAM_derivate_00000299/sequence/phys_ThStAM_derivate_00000299"}], "metadata": [{"label": "title", "value": "Werner Erzbischof von Mainz (Maguntin.), des heiligen Reiches Erzkanzler für Deutschland, bekundet: ihm wurde von glaubwürdigen geistlichen und anderen Personen mitgeteilt, daß in einer der Jungfrau Maria geweihten, bei Frankenstein in seiner Diözese gelegenen Kapelle Wunder geschehen sind. Die Kapelle wurde vor Zeiten zerstört und bedarf deshalb der Reparatur. Der Erzbischof möchte daher die Gläubigen zu Werken der Nächstenliebe anregen und sichert allen, die sich um die Kapelle durch Almosen und andere fromme Werke verdient machen, beim Besuch jeweils einen Ablaß von 40 Tagen zu, sofern sie wirklich bereuen und gebeichtet haben. Er wird darüber hinaus Ablässe ratifizieren, die seine Suffragane der Kapelle erteilen."}], "structures": [{"metadata": [{"label": "title", "value": "Werner Erzbischof von Mainz (Maguntin.), des heiligen Reiches Erzkanzler für Deutschland, bekundet: ihm wurde von glaubwürdigen geistlichen und anderen Personen mitgeteilt, daß in einer der Jungfrau Maria geweihten, bei Frankenstein in seiner Diözese gelegenen Kapelle Wunder geschehen sind. Die Kapelle wurde vor Zeiten zerstört und bedarf deshalb der Reparatur. Der Erzbischof möchte daher die Gläubigen zu Werken der Nächstenliebe anregen und sichert allen, die sich um die Kapelle durch Almosen und andere fromme Werke verdient machen, beim Besuch jeweils einen Ablaß von 40 Tagen zu, sofern sie wirklich bereuen und gebeichtet haben. Er wird darüber hinaus Ablässe ratifizieren, die seine Suffragane der Kapelle erteilen."}], "ranges": [], "canvases": ["https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/ThStAM_derivate_00000299/canvas/ThStAM_derivate_00000299%2FUkM_A_002_1.tif", "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/ThStAM_derivate_00000299/canvas/ThStAM_derivate_00000299%2FUkM_A_002_2.tif", "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/ThStAM_derivate_00000299/canvas/ThStAM_derivate_00000299%2FUkM_A_002_5.tif", "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/ThStAM_derivate_00000299/canvas/ThStAM_derivate_00000299%2FUkM_A_002_6a.tif", "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/ThStAM_derivate_00000299/canvas/ThStAM_derivate_00000299%2FUkM_A_002_6b.tif"], "label": "Werner Erzbischof von Mainz (Maguntin.), des heiligen Reiches Erzkanzler für Deutschland, bekundet: ihm wurde von glaubwürdigen [...]", "viewingHint": "top", "@type": "sc:Range", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/ThStAM_derivate_00000299/range/log_ThStAM_derivate_00000299"}], "label": "Werner Erzbischof von Mainz (Maguntin.), des heiligen Reiches Erzkanzler für Deutschland, bekundet: ihm wurde von glaubwürdigen geistlichen und anderen Personen mitgeteilt, daß in einer der Jungfrau Maria geweihten, bei Frankenstein in seiner Diözese gelegenen Kapelle Wunder geschehen sind. Die Kapelle wurde vor Zeiten zerstört und bedarf deshalb der Reparatur. Der Erzbischof möchte daher die Gläubigen zu Werken der Nächstenliebe anregen und sichert allen, die sich um die Kapelle durch Almosen und andere fromme Werke verdient machen, beim Besuch jeweils einen Ablaß von 40 Tagen zu, sofern sie wirklich bereuen und gebeichtet haben. Er wird darüber hinaus Ablässe ratifizieren, die seine Suffragane der Kapelle erteilen.", "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "sc:Manifest", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/ThStAM_derivate_00000299/manifest"}