if/presentation/v2/saru_derivate_00001128/canvas/saru_derivate_00001128%2FPD_0750.tif"}, {"images": [{"resource": {"service": {"profile": "http://iiif.io/api/image/2/profiles/level2.json", "@context": "http://iiif.io/api/image/2/context.json", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/image/v2/saru_derivate_00001128%2FPD_0751.tif"}, "width": 3336, "height": 3531, "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "dctypes:Image", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/image/v2/saru_derivate_00001128%2FPD_0751.tif"}, "on": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001128/canvas/saru_derivate_00001128%2FPD_0751.tif", "motivation": "sc:painting", "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "@oa:Annotation", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001128/annotation/saru_derivate_00001128%2FPD_0751.tif"}], "metadata": [], "label": "urn:nbn:de:urmel-saru-11289-8-69", "height": 3531, "width": 3336, "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "sc:Canvas", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001128/canvas/saru_derivate_00001128%2FPD_0751.tif"}], "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "sc:Sequence", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001128/sequence/phys_saru_derivate_00001128"}], "metadata": [{"label": "title", "value": "Die Brüder Reinhard und Erasmus von Holbach, Söhne Reinhards von Holbach, der früher in Wenigen Libergen wohnte, beurkunden, dass sie mit Einwilligung ihres Lehnsherrn Johannes, des Abts des Klosters Paulinzella, 3 Pfund und 8 Schillinge Pfennige und 6 Hühner Erbzinsen, jährlich am Michaelstage zu zahlen, dem Abt Johannes, dem Prior Heinrich und der ganzen Sammnung, den herren alt unde iung gemeynlichin des Klosters Paulinzella verkauft haben. Die betreffenden Zinsen ruhen auf Gütern in Nedirn Swarcza: Heynrich Smed gibt von Haus und Hof und von einem Vierteil Erbes 16 Schillinge Pfennige und 1 Huhn, Hannes Wentzman von einer halben Hufe Landes 29 Schillinge und von einem Hofe halb 1 Schilling und 1 Huhn, Peter Wolf von Haus und Hof 1 Schilling, Clauwis Melding und sein Bruder von zwei Vierteilen Landes 6 Schillinge und 2 Hühner, Volrad Vichser (Fischer?) von einem Vierteil Erbes 15 Schillinge und 2 Hühner. Dafür haben die Käufer 57 Pfund guter Pfennige bezahlt."}], "structures": [{"metadata": [{"label": "title", "value": "Die Brüder Reinhard und Erasmus von Holbach, Söhne Reinhards von Holbach, der früher in Wenigen Libergen wohnte, beurkunden, dass sie mit Einwilligung ihres Lehnsherrn Johannes, des Abts des Klosters Paulinzella, 3 Pfund und 8 Schillinge Pfennige und 6 Hühner Erbzinsen, jährlich am Michaelstage zu zahlen, dem Abt Johannes, dem Prior Heinrich und der ganzen Sammnung, den herren alt unde iung gemeynlichin des Klosters Paulinzella verkauft haben. Die betreffenden Zinsen ruhen auf Gütern in Nedirn Swarcza: Heynrich Smed gibt von Haus und Hof und von einem Vierteil Erbes 16 Schillinge Pfennige und 1 Huhn, Hannes Wentzman von einer halben Hufe Landes 29 Schillinge und von einem Hofe halb 1 Schilling und 1 Huhn, Peter Wolf von Haus und Hof 1 Schilling, Clauwis Melding und sein Bruder von zwei Vierteilen Landes 6 Schillinge und 2 Hühner, Volrad Vichser (Fischer?) von einem Vierteil Erbes 15 Schillinge und 2 Hühner. Dafür haben die Käufer 57 Pfund guter Pfennige bezahlt."}], "ranges": [], "canvases": ["https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001128/canvas/saru_derivate_00001128%2FPD_0746.tif", "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001128/canvas/saru_derivate_00001128%2FPD_0747.tif", "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001128/canvas/saru_derivate_000011