n/2/context.json", "@type": "dctypes:Image", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/image/v2/saru_derivate_00001317%2FPD_1033.tif"}, "on": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/canvas/saru_derivate_00001317%2FPD_1033.tif", "motivation": "sc:painting", "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "@oa:Annotation", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/annotation/saru_derivate_00001317%2FPD_1033.tif"}], "metadata": [], "label": "urn:nbn:de:urmel-saru-13175-8-46", "height": 2624, "width": 2184, "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "sc:Canvas", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/canvas/saru_derivate_00001317%2FPD_1033.tif"}], "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "sc:Sequence", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/sequence/phys_saru_derivate_00001317"}], "metadata": [{"label": "title", "value": "Abt Johannes von Paulinzelle überträgt auf Bitten des Hans Ruse des Älteren von Blankenburg, Lehnsmanns des Klosters Paulinzella, die Zinsen, welche dessen Eltern und er bisher vom Kloster zu Lehen gehabt haben, nämlich von Hans König (Konnigk) zu Obernschwarze 8 ½ Schillinge Pfennige und 4 Hühner auf Michaelstag von Holz und Weingarten mit Zubehör hinter seinem Hofe und von Hans Koch 6 Schillinge und 1 Huhn von einem Weingarten in der Warfe auf Klaus Brome zu Saalfeld. Falls Ruse seine Zinsen oder Brome sein Geld wiederhaben will, so soll die Kündigung ein Vierteljahr vor Michaelistage erfolgen, dann soll Hans Ruse dem Brome, oder wer die Zinsen innehat, 7 Gulden geben und Brome soll ihm dann die Zinsen auflassen. Ruse hängt sein Siegel nach dem des Abtes an."}], "structures": [{"metadata": [{"label": "title", "value": "Abt Johannes von Paulinzelle überträgt auf Bitten des Hans Ruse des Älteren von Blankenburg, Lehnsmanns des Klosters Paulinzella, die Zinsen, welche dessen Eltern und er bisher vom Kloster zu Lehen gehabt haben, nämlich von Hans König (Konnigk) zu Obernschwarze 8 ½ Schillinge Pfennige und 4 Hühner auf Michaelstag von Holz und Weingarten mit Zubehör hinter seinem Hofe und von Hans Koch 6 Schillinge und 1 Huhn von einem Weingarten in der Warfe auf Klaus Brome zu Saalfeld. Falls Ruse seine Zinsen oder Brome sein Geld wiederhaben will, so soll die Kündigung ein Vierteljahr vor Michaelistage erfolgen, dann soll Hans Ruse dem Brome, oder wer die Zinsen innehat, 7 Gulden geben und Brome soll ihm dann die Zinsen auflassen. Ruse hängt sein Siegel nach dem des Abtes an."}], "ranges": [], "canvases": ["https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/canvas/saru_derivate_00001317%2FPD_1030.tif", "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/canvas/saru_derivate_00001317%2FPD_1031.tif", "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/canvas/saru_derivate_00001317%2FPD_1032.tif", "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/canvas/saru_derivate_00001317%2FPD_1033.tif"], "label": "Abt Johannes von Paulinzelle überträgt auf Bitten des Hans Ruse des Älteren von Blankenburg, Lehnsmanns des Klosters Paulinzell [...]", "viewingHint": "top", "@type": "sc:Range", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/range/log_saru_derivate_00001317"}], "label": "Abt Johannes von Paulinzelle überträgt auf Bitten des Hans Ruse des Älteren von Blankenburg, Lehnsmanns des Klosters Paulinzella, die Zinsen, welche dessen Eltern und er bisher vom Kloster zu Lehen gehabt haben, nämlich von Hans König (Konnigk) zu Obernschwarze 8 ½ Schillinge Pfennige und 4 Hühner auf Michaelstag von Holz und Weingarten mit Zubehör hinter seinem Hofe und von Hans Koch 6 Schillinge und 1 Huhn von einem Weingarten in der Warfe auf Klaus Brome zu Saalfeld. Falls Ruse seine Zinsen oder Brome sein Geld wiederhaben will, so soll die Kündigung ein Vierteljahr vor Michaelistage erfolgen, dann soll Hans Ruse dem Brome, oder wer die Zinsen innehat, 7 Gulden geben und Brome soll ihm dann die Zinsen auflassen. Ruse hängt sein Siegel nach dem des Abtes an.", "@context": "http://iiif.io/api/presentation/2/context.json", "@type": "sc:Manifest", "@id": "https://staatsarchive.thulb.uni-jena.de/api/iiif/presentation/v2/saru_derivate_00001317/manifest"}